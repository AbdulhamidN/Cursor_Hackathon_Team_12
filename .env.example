# Copy this file to `.env` in the repository root:  Copy-Item .env.example .env
# `.env` is git-ignored. Never commit real secrets and never paste them into chat or docs.

# --- API (apps/api) --------------------------------------------------------
NODE_ENV=development
API_PORT=4000

# Local MongoDB (Windows service or `docker compose -f infrastructure/docker-compose.yml up -d`).
# For MongoDB Atlas, paste the mongodb+srv:// connection string here instead.
MONGODB_URI=mongodb://127.0.0.1:27017/ethiopian_coffee_buy

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Gemini API key. Server-side only: it is read by apps/api and must never be
# given a VITE_ prefix or referenced from apps/web.
GEMINI_API_KEY=

# --- Web (apps/web) --------------------------------------------------------
# Only variables prefixed with VITE_ reach the browser, so never put a secret in one.
# Leave empty in development: Vite proxies /api to the API on API_PORT.
# Set it only when the built web app is served from a different origin than the API.
VITE_API_BASE_URL=
