{
  "name": "@ecb/api",
  "version": "0.1.0",
  "private": true,
  "description": "Ethiopian Coffee Buy REST API (Express + Mongoose).",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ecb/contracts": "*",
    "@ecb/shared": "*",
    "@ecb/validation": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ecb/config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
