{
  "name": "ethiopian-coffee-buy",
  "version": "0.1.0",
  "private": true,
  "description": "Ethiopian Coffee Buy - marketplace, payments and traceability platform for Ethiopian coffee.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @ecb/api",
    "dev:web": "npm run dev --workspace @ecb/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @ecb/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit --project tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@ecb/config": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
